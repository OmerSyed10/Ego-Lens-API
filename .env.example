# ═══════════════════════════════════════════════════════════════════
#  EgoLens Auto-QC  —  Environment Variables
#  Copy this file to .env, fill in real values, never commit to git.
# ═══════════════════════════════════════════════════════════════════

# ─── PostgreSQL Database ─────────────────────────────────────────────
DB_HOST=your-db-host.rds.amazonaws.com
DB_PORT=5432
DB_SCHEMA=lightwheel
DB_NAME=postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ─── AWS S3 ──────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
# S3 bucket that holds all robotics videos (discovered: project-parallax)
AWS_S3_BUCKET=project-parallax
# If videos are in a requester-pays bucket or behind a specific endpoint:
# AWS_ENDPOINT_URL=

# ─── S3 source view / table ──────────────────────────────────────────
# Name of the view that exposes asset + S3 details
ASSETS_VIEW=robotics_qc_assets
# asset_id column name in the view
ASSETS_COL_ASSET_ID=asset_id
# NOTE: S3 path is parsed from the JSON 'views' column (expected_slot=main, present=true)
# AWS_S3_BUCKET + views[].bucket_key → s3://<bucket>/<bucket_key>

# ─── Pipeline tunables ───────────────────────────────────────────────
# Max videos to process in one run (0 = no limit)
BATCH_LIMIT=0
# Local temp directory for downloaded videos (uses system tmp if empty)
TMP_DIR=
